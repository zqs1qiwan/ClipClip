# ClipClip deployment environment template.
#
# Copy to `.env` next to docker-compose.yml, then edit:
#   cp .env.example .env
# `.env` is gitignored. Never commit real tokens or copy a filled `.env` into an image.
# `docker compose` interpolates the variables below automatically (values shown are the
# built-in defaults, so an unmodified copy behaves exactly like the defaults).
#
# Two deployment modes (mode is frozen when the process starts):
#   CLIPCLIP_ACCESS_TOKEN empty      -> local mode (trusted LAN, no login)
#   CLIPCLIP_ACCESS_TOKEN non-empty  -> public mode (login + session cookie + 401 guards)
# Public mode still requires a front door: Cloudflare Access or an authenticating reverse
# proxy. See README "Two deployment modes" and docs/SECURITY.md.

# ---------------------------------------------------------------------------
# Mode / access control
# ---------------------------------------------------------------------------
# Application-level token for public mode. Generate with: openssl rand -base64 32
# Leave empty for local mode. Never commit the real value.
CLIPCLIP_ACCESS_TOKEN=

# Trust X-Forwarded-For for rate limiting ONLY behind a trusted reverse proxy or
# Cloudflare Tunnel that overwrites XFF. 0 = off (default), 1 = trust the header.
# Never enable this when the app is directly exposed.
CLIPCLIP_TRUST_PROXY=0

# Login session lifetime in seconds (default 86400 = 24h).
CLIPCLIP_SESSION_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Host binding (compose-only; not passed into the container)
# ---------------------------------------------------------------------------
# Host address the published port binds to. Use 127.0.0.1 in public mode so LAN clients
# must go through the tunnel / reverse proxy. Default 0.0.0.0 (all interfaces).
CLIPCLIP_BIND_IP=0.0.0.0

# Host port for the published mapping (default 5678).
CLIPCLIP_HOST_PORT=5678

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Keep 0.0.0.0 inside the container when publishing ports (loopback bind breaks DNAT).
CLIPCLIP_HOST=0.0.0.0
CLIPCLIP_PORT=5678

# Data root. The provided compose file pins this to /data and mounts the volume there;
# change it only for direct runs (`npm start`) when you also relocate the volume.
CLIPCLIP_DATA_DIR=/data

# Absolute public base URL used for generated links. Reserved; currently unused by the
# server (links are returned relative), so leave empty.
CLIPCLIP_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Limits and retention
# ---------------------------------------------------------------------------
CLIPCLIP_MAX_UPLOAD_MB=50
CLIPCLIP_RECENT_FILES_LIMIT=10
CLIPCLIP_PASTE_TTL_HOURS=24
CLIPCLIP_PASTE_TTL_MAX_HOURS=168
CLIPCLIP_PASTE_CONTENT_LIMIT=524288
CLIPCLIP_FILE_TTL_HOURS=24
CLIPCLIP_CLEANUP_INTERVAL_MS=60000
CLIPCLIP_LIVE_CONTENT_LIMIT=100000

# ---------------------------------------------------------------------------
# Server-Sent Events governance
# ---------------------------------------------------------------------------
CLIPCLIP_MAX_SSE_CLIENTS=100
CLIPCLIP_SSE_HEARTBEAT_MS=25000
CLIPCLIP_SSE_IDLE_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Runtime-only tuning (read by src/server/config.js, NOT forwarded by
# docker-compose.yml). Set them in a compose override file or when starting the
# process directly (`npm start`); values in this file alone have no effect in compose.
# ---------------------------------------------------------------------------
# CLIPCLIP_MAX_PASTE_PASSPHRASE_LEN=128
# CLIPCLIP_REVEAL_RATE_LIMIT=5
# CLIPCLIP_REVEAL_RATE_WINDOW_MS=60000